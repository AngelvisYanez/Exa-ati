# Copiar a .env.plesk-production solo en Plesk, permisos 600.
NEXT_PUBLIC_APP_URL=https://ati.exacontable.com
EXA_ATI_IMAGE_TAG=REEMPLAZAR_SHA_PUBLICADO
EXA_ATI_DB_ISOLATED=true
EXA_ATI_SOURCE_DB_HOST=ep-wild-smoke-aiylclv6-pooler.c-4.us-east-1.aws.neon.tech
# Activar solo después del respaldo final y la congelación de escrituras en cPanel.
EXA_ATI_PRODUCTION_READY=false
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-POOLER/BASE?sslmode=require
DIRECT_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
JWT_SECRET=REEMPLAZAR
ENCRYPTION_KEY=REEMPLAZAR
ENCRYPTION_SALT=REEMPLAZAR
CRON_SECRET=REEMPLAZAR
XMLS_DIR=/app/downloads/xmls
CERTS_DIR=/app/downloads/certs
PDFS_DIR=/app/downloads/pdfs
TEMPLATES_DIR=/app/downloads/templates
# Trasladar aquí únicamente las integraciones reales del cPanel por vía privada.
# No copiar los WSDL de pruebas desde .env.plesk-test.
