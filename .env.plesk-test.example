# Copiar a .env.plesk-test en el servidor. Nunca subir el archivo real a Git.
NEXT_PUBLIC_APP_URL=https://ati.exacontable.com
EXA_ATI_TEST_PORT=3101
EXA_ATI_IMAGE_TAG=REEMPLAZAR_SHA_PUBLICADO
EXA_ATI_DB_ISOLATED=true
EXA_ATI_SOURCE_DB_HOST=ep-wild-smoke-aiylclv6-pooler.c-4.us-east-1.aws.neon.tech
NODE_ENV=production
HEADLESS=true
SRI_ENVIRONMENT=development
SRI_RECEPTION_WSDL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_AUTHORIZATION_WSDL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
NEXT_PUBLIC_DEV_MODE=false

# Rama/copia aislada de Neon. La URL normal usa -pooler; la directa es para migraciones.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-POOLER/BASE?sslmode=require
DIRECT_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require

# Conservar los secretos originales solo si se necesita descifrar datos copiados.
JWT_SECRET=REEMPLAZAR
ENCRYPTION_KEY=REEMPLAZAR
ENCRYPTION_SALT=REEMPLAZAR
CRON_SECRET=REEMPLAZAR

XMLS_DIR=/app/downloads/xmls
CERTS_DIR=/app/downloads/certs
PDFS_DIR=/app/downloads/pdfs
TEMPLATES_DIR=/app/downloads/templates

# Activar cada integración solo tras verificarla en el dominio de pruebas.
# ANTICAPTCHA_KEY=
# SCRAPELESS_API_KEY=
# SCRAPING_USE_PROXY=false
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# SMTP_HOST=
# PAYPHONE_TOKEN=
# PAYPHONE_STORE_ID=
# PAYPHONE_APP_URL=https://ati.exacontable.com
