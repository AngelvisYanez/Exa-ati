  fecha       DateTime @db.Date
  monto       Decimal  @db.Decimal(14, 2)
  metodoPago  String?  @map("metodo_pago") @db.VarChar(50)
  referencia  String?  @db.VarChar(100)
  notas       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  cuentaCobrar CuentaPorCobrar? @relation(fields: [cuentaCobrarId], references: [id])
  cuentaPagar  CuentaPorPagar?  @relation(fields: [cuentaPagarId], references: [id])

  @@index([tenantId, tipoCuenta])
  @@index([tenantId, fecha])
  @@map("pagos_cuentas")
}

// ─────────────────────────────────────────────
// ASIENTOS CONTABLES (Libro Diario)
// ─────────────────────────────────────────────
model Asiento {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  fecha         DateTime @db.Date
  numero        Int
  glosa         String   @db.VarChar(500)
  origen        String   @default("MANUAL") @db.VarChar(50)
  comprobanteId String?  @map("comprobante_id") @db.Uuid
  estado        String   @default("BORRADOR") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lineas AsientoLinea[]

  @@unique([tenantId, numero])
  @@map("asientos")
}

model AsientoLinea {
  id           String  @id @default(uuid()) @db.Uuid
  asientoId    String  @map("asiento_id") @db.Uuid
  cuentaCodigo String  @map("cuenta_codigo") @db.VarChar(20)
  cuentaNombre String  @map("cuenta_nombre") @db.VarChar(255)
  debe         Decimal @db.Decimal(14, 2)
  haber        Decimal @db.Decimal(14, 2)
  orden        Int

  asiento Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)

  @@index([asientoId])
  @@map("asiento_lineas")
}

// ─────────────────────────────────────────────
// INVENTARIO MOVIMIENTOS (Kardex)
// ─────────────────────────────────────────────
model InventarioMovimiento {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productoId   String   @map("producto_id") @db.Uuid
  tipo         String   @db.VarChar(10)
  cantidad     Decimal  @db.Decimal(10, 2)
  stockAntes   Decimal  @map("stock_antes") @db.Decimal(10, 2)
  stockDespues Decimal  @map("stock_despues") @db.Decimal(10, 2)
  motivo       String?  @db.VarChar(255)
  referencia   String?  @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([tenantId, productoId])
  @@map("inventario_movimientos")
}

// ─────────────────────────────────────────────
// NOTIFICACIONES (App / Email / WhatsApp)
// ─────────────────────────────────────────────
model Notificacion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ruc         String?  @db.VarChar(20)
  dedupeKey   String   @map("dedupe_key") @db.VarChar(120)
  type        String   @db.VarChar(30)
  title       String   @db.VarChar(255)
  body        String   @db.Text
  channel     String   @db.VarChar(20)
  unread      Boolean  @default(true)
  actionLabel String?  @map("action_label") @db.VarChar(100)
  actionHref  String?  @map("action_href") @db.VarChar(255)
  eventAt     DateTime @map("event_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, unread])
  @@index([tenantId, eventAt])
  @@map("notificaciones")
}
